<Window x:Class="Pitanga.Menu.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:menu="clr-namespace:Pitanga.Menu"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        Width="440" Height="440" Focusable="False"
        FontFamily="{StaticResource DisplayFont}">

    <!-- #01: janela "layered" ignora pixels com alfa 0 no hit-test; com alfa 1 ela recebe o drag OLE. -->
    <Grid x:Name="Root" Background="#01FFFFFF" AllowDrop="True">
        <Grid x:Name="Stage" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="StageScale" ScaleX="0.72" ScaleY="0.72"/>
            </Grid.RenderTransform>

            <!-- Sombra projetada -->
            <!-- Sombra feita com gradiente radial (sem efeito: barato também sem GPU) -->
            <Ellipse Width="368" Height="368" Margin="0,16,0,0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#40000000" Offset="0.72"/>
                        <GradientStop Color="#1C000000" Offset="0.86"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Vidro: captura da tela desfocada + tinta quente, recortada em círculo antialiased -->
            <Grid Width="300" Height="300" IsHitTestVisible="False">
                <Grid.Clip>
                    <EllipseGeometry Center="150,150" RadiusX="150" RadiusY="150"/>
                </Grid.Clip>
                <!-- Já chega desfocada de ScreenUtil.CaptureBlurred -->
                <Image x:Name="Backdrop" Width="440" Height="440" Margin="-70" Stretch="Fill"/>
                <Rectangle Fill="#8CFFF6EC"/>
            </Grid>

            <menu:RadialMenuControl x:Name="Wheel" Width="440" Height="440" IsHitTestVisible="False"/>

            <Ellipse Width="300" Height="300" Stroke="#B3FFFFFF" StrokeThickness="1" IsHitTestVisible="False"/>

            <!-- Miolo vazado: arquivo arrastado -->
            <Grid Width="108" Height="108" IsHitTestVisible="False">
                <Ellipse Fill="#E6FFFDFA" Stroke="#1A000000" StrokeThickness="1"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="46" Height="48" HorizontalAlignment="Center">
                        <Border x:Name="ThumbBorder" Width="46" Height="46" CornerRadius="8"
                                BorderBrush="#26000000" BorderThickness="1" Visibility="Collapsed"/>
                        <Border x:Name="DocGlyph" Width="36" Height="46" CornerRadius="6" Background="White"
                                BorderBrush="#2E000000" BorderThickness="1">
                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,7"
                                    CornerRadius="3" Background="{StaticResource AccentBrush}" Padding="4,1">
                                <TextBlock x:Name="GlyphExt" Text="FILE" FontSize="8.5" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="FileLabel" FontSize="10" MaxWidth="84" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Foreground="#5B3416"/>
                    <TextBlock x:Name="ModeHint" FontSize="9" Opacity="0.65" HorizontalAlignment="Center" Foreground="#5B3416"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
