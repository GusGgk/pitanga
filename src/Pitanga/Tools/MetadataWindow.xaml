<ui:MacWindow x:Class="Pitanga.Tools.MetadataWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:Pitanga.UI"
              Title="Metadata" Width="680" Height="760" MinWidth="520" MinHeight="480">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Margin="22,0,22,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Thumb" Width="72" Height="72" CornerRadius="10" BorderBrush="#1F000000" BorderThickness="1"/>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="FileName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="Summary" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                <Border x:Name="GpsBadge" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Background="#1AFF453A" CornerRadius="6" Padding="8,3">
                    <TextBlock Text="Contains GPS location" FontSize="11" FontWeight="SemiBold" Foreground="#D93A30"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Tabela chave / valor -->
        <Border Grid.Row="1" Margin="16,0,16,0" CornerRadius="10" Background="White" BorderBrush="#14000000" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6">
                <ItemsControl x:Name="Rows" AlternationCount="2">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" Padding="14,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" FontSize="12" IsReadOnly="True"
                                             BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Padding="0"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="1">
                                    <Setter TargetName="Row" Property="Background" Value="#F7F6F4"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,14,22,18">
            <Button Content="Close" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Close_Click"/>
            <Button x:Name="StripButton" Content="Remove All Metadata" Style="{StaticResource PrimaryButton}" Click="Strip_Click"/>
        </StackPanel>
    </Grid>
</ui:MacWindow>
