<ui:MacWindow x:Class="Pitanga.Tools.EditWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:Pitanga.UI"
              Title="Edit" Width="1000" Height="820" MinWidth="760" MinHeight="600">
    <ui:MacWindow.Resources>
        <Style x:Key="ToolGlyph" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource TextBrush}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
    </ui:MacWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Margin="16,0,16,0" CornerRadius="10" Background="{StaticResource CanvasBrush}" ClipToBounds="True">
            <Image x:Name="PreviewImage" Margin="28" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>

        <Grid Grid.Row="1" Margin="26,16,26,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="64"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Transform" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" ToolTip="Rotate left" Click="RotateLeft_Click">
                    <Path Style="{StaticResource ToolGlyph}" Data="M4,9 A8,8 0 1 1 6,17 M4,4 V9 H9"/>
                </Button>
                <Button Style="{StaticResource IconButton}" ToolTip="Rotate right" Click="RotateRight_Click">
                    <Path Style="{StaticResource ToolGlyph}" Data="M20,9 A8,8 0 1 0 18,17 M20,4 V9 H15"/>
                </Button>
                <Button Style="{StaticResource IconButton}" ToolTip="Flip horizontal" Click="FlipH_Click">
                    <Path Style="{StaticResource ToolGlyph}" Data="M12,3 V21 M8,7 L3,12 L8,17 Z M16,7 L21,12 L16,17 Z"/>
                </Button>
                <Button Style="{StaticResource IconButton}" ToolTip="Flip vertical" Click="FlipV_Click">
                    <Path Style="{StaticResource ToolGlyph}" Data="M3,12 H21 M7,8 L12,3 L17,8 Z M7,16 L12,21 L17,16 Z"/>
                </Button>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="Brightness" Style="{StaticResource FieldLabel}"/>
            <Slider x:Name="BrightnessSlider" Grid.Row="1" Grid.Column="1" Style="{StaticResource MacSlider}" Minimum="-100" Maximum="100" ValueChanged="Slider_Changed"/>
            <TextBlock x:Name="BrightnessValue" Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueLabel}" Text="0"/>

            <TextBlock Grid.Row="2" Text="Contrast" Style="{StaticResource FieldLabel}"/>
            <Slider x:Name="ContrastSlider" Grid.Row="2" Grid.Column="1" Style="{StaticResource MacSlider}" Minimum="-100" Maximum="100" ValueChanged="Slider_Changed"/>
            <TextBlock x:Name="ContrastValue" Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueLabel}" Text="0"/>

            <TextBlock Grid.Row="3" Text="Saturation" Style="{StaticResource FieldLabel}"/>
            <Slider x:Name="SaturationSlider" Grid.Row="3" Grid.Column="1" Style="{StaticResource MacSlider}" Minimum="-100" Maximum="100" ValueChanged="Slider_Changed"/>
            <TextBlock x:Name="SaturationValue" Grid.Row="3" Grid.Column="2" Style="{StaticResource ValueLabel}" Text="0"/>

            <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Reset" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Reset_Click"/>
                <Button x:Name="ApplyButton" Content="Apply" Style="{StaticResource PrimaryButton}" MinWidth="96" Click="Apply_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:MacWindow>
