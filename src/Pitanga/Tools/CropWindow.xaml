<ui:MacWindow x:Class="Pitanga.Tools.CropWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:Pitanga.UI"
              xmlns:tools="clr-namespace:Pitanga.Tools"
              Title="Crop" Width="1000" Height="780" MinWidth="760" MinHeight="540">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Margin="16,0,16,0" CornerRadius="10" Background="{StaticResource CanvasBrush}" ClipToBounds="True">
            <tools:CropCanvas x:Name="CropArea"/>
        </Border>

        <Grid Grid.Row="1" Margin="22,14,22,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SegmentHost}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FreeRatio" Style="{StaticResource Segment}" GroupName="ratio" Content="Free" Tag="0" IsChecked="True" Checked="Ratio_Checked"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="ratio" Content="1:1" Tag="1" Checked="Ratio_Checked"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="ratio" Content="16:9" Tag="1.7777777777777777" Checked="Ratio_Checked"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="ratio" Content="4:3" Tag="1.3333333333333333" Checked="Ratio_Checked"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="ratio" Content="3:4" Tag="0.75" Checked="Ratio_Checked"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Width" Style="{StaticResource Caption}" Margin="0,0,8,0"/>
                <TextBox x:Name="WidthBox" Style="{StaticResource FieldBox}" KeyDown="Size_KeyDown" LostKeyboardFocus="Size_LostFocus"/>
                <TextBlock Text="×" Style="{StaticResource Caption}" Margin="10,0"/>
                <TextBlock Text="Height" Style="{StaticResource Caption}" Margin="0,0,8,0"/>
                <TextBox x:Name="HeightBox" Style="{StaticResource FieldBox}" KeyDown="Size_KeyDown" LostKeyboardFocus="Size_LostFocus"/>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Reset" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Reset_Click"/>
                <Button x:Name="ApplyButton" Content="Apply" Style="{StaticResource PrimaryButton}" MinWidth="96" Click="Apply_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:MacWindow>
